# .clangd — clangd config for Arduino Giga R1 projects

CompileFlags:
  Add:
    - "-std=c++17"
    - "-DARDUINO=10819"
    - "-DARDUINO_GIGA"
    - "-DARDUINO_ARCH_STM32"
    - "-D__ARM_ARCH"
    - "-DCORE_CALLBACK"
    - "-w"

    # Arduino core
    - "-isystem/home/tanner/.arduino15/packages/arduino/hardware/mbed_giga/4.5.0/cores/arduino"
    - "-isystem/home/tanner/.arduino15/packages/arduino/hardware/mbed_giga/4.5.0/variants/GIGA"

    # Built-in libraries
    - "-isystem/home/tanner/.arduino15/packages/arduino/hardware/mbed_giga/4.5.0/libraries/WiFi/src"
    - "-isystem/home/tanner/.arduino15/packages/arduino/hardware/mbed_giga/4.5.0/libraries/Wire/src"
    - "-isystem/home/tanner/.arduino15/packages/arduino/hardware/mbed_giga/4.5.0/libraries/SPI/src"
    - "-isystem/home/tanner/.arduino15/packages/arduino/hardware/mbed_giga/4.5.0/libraries/PDM/src"
    - "-isystem/home/tanner/.arduino15/packages/arduino/hardware/mbed_giga/4.5.0/libraries/RPC/src"

    # ARM toolchain
    - "-isystem/home/tanner/.arduino15/packages/arduino/tools/arm-none-eabi-gcc/7-2017q4/arm-none-eabi/include"
    - "-isystem/home/tanner/.arduino15/packages/arduino/tools/arm-none-eabi-gcc/7-2017q4/arm-none-eabi/include/c++/7.2.1"

  Remove:
    - "-W*"

Diagnostics:
  Suppress:
    - pp_file_not_found
    - err_undeclared_var_use
    - err_unknown_type_name
    - err_no_member                              # "No member named X in arduino::Y"
    - err_ovl_no_viable_member_function_in_call  # "No matching member function for call to X"
    - err_typecheck_member_reference_suggestion
    - err_use_of_undeclared_identifier
    - err_no_viable_overloaded_assign

Index:
  Background: Skip
