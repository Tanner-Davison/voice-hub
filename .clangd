# .clangd — clangd config for Arduino Giga R1 projects
#
# compile_commands.json (generated by arduino-cli) handles all include paths
# and compiler flags. This file only suppresses noise from third-party libraries.

---
# Suppress all diagnostics inside Arduino SDK and library files
If:
  PathMatch:
    - ".*/Arduino/libraries/.*"
    - ".*/arduino15/packages/.*"
    - ".*/arduino15/staging/.*"
    - ".*/.cache/arduino/.*"
Diagnostics:
  Suppress: ["*"]
